{
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "music.omegabone.com" }],
      "destination": "https://omegabone.bandcamp.com/",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "music.omegabone.com" }],
      "destination": "https://omegabone.bandcamp.com/:path*",
      "permanent": false
    },
    {
      "source": "/ornithology",
      "destination": "/orinthology",
      "permanent": false
    },
    {
      "source": "/todos",
      "destination": "https://claude.ai/code/artifact/cb27b87a-df22-442d-83b3-606d52e5008d",
      "permanent": false
    },
    {
      "source": "/files",
      "destination": "https://claude.ai/code/artifact/9e26c22b-0d4d-41d8-a66a-d0d7fc60811e",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/clipper",
      "destination": "/clipper.html"
    },
    {
      "source": "/antoine",
      "destination": "/antoine.html"
    },
    {
      "source": "/orinthology",
      "destination": "/orinthology.html"
    },
    {
      "source": "/workplaceharassment",
      "destination": "/workplaceharassment.html"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/workplaceharassment(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/audio/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ]
}
